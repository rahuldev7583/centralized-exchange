// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum UserType {
    User
    Admin
}

enum MarketType {
    Spot
    Perp
}

model Admin {
    admin_id Int    @id @default(autoincrement())
    username String
    password String

    user_type UserType @default(Admin)

    asset  Asset[]
    market Market[]

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}

model User {
    user_id  Int     @id @default(autoincrement())
    username String
    email    String?
    password String

    created_at DateTime        @default(now())
    updated_at DateTime        @default(now())
    user_type  UserType        @default(User)
    orders     Order[]
    asset      Asset_balance[]
    leverage   leverage[]

    buyFill   Fill[]     @relation("BuyFill")
    sellFill  Fill[]     @relation("SellFill")
    positions Position[]
}

model Asset {
    id       Int    @id @default(autoincrement())
    name     String
    symbol   String @unique
    decimals BigInt

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    admin         Admin? @relation(fields: [adminAdmin_id], references: [admin_id])
    adminAdmin_id Int?

    base_markets  Market[]        @relation("BaseAsset")
    quote_markets Market[]        @relation("QuoteAsset")
    assetBalances Asset_balance[]

    last_traded_price Decimal @db.Decimal(78, 0)

    price AssetPrice[]
}

model Market {
    id     Int    @id @default(autoincrement())
    name   String
    symbol String @unique

    base_asset_id  Int
    quote_asset_id Int

    base_asset  Asset @relation("BaseAsset", fields: [base_asset_id], references: [id])
    quote_asset Asset @relation("QuoteAsset", fields: [quote_asset_id], references: [id])

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    admin         Admin? @relation(fields: [adminAdmin_id], references: [admin_id])
    adminAdmin_id Int?

    orders Order[]

    type      MarketType
    positions Position[]
}

model Asset_balance {
    id             Int     @id @default(autoincrement())
    balance        Decimal @db.Decimal(78, 0)
    locked_balance Decimal @db.Decimal(78, 0)

    asset Asset @relation(fields: [assetId], references: [id])

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    assetId Int
    user    User @relation(fields: [user_id], references: [user_id])
    user_id Int

    @@unique([user_id, assetId])
}

model Order {
    id       String  @id
    type     String
    price    Decimal @db.Decimal(78, 0)
    quantity Int
    filled   Int
    status   String
    side     String

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    market    Market @relation(fields: [market_id], references: [id])
    user      User   @relation(fields: [user_id], references: [user_id])
    market_id Int
    user_id   Int

    entry_price    Decimal @db.Decimal(78, 0)
    initial_margin Decimal @default(0) @db.Decimal(78, 0)

    ask_fill Fill[] @relation("AskOrder")
    bid_fill Fill[] @relation("BidOrder")
}

model Fill {
    id       String  @id
    type     String
    price    Decimal @db.Decimal(78, 0)
    quantity Int
    symbol   String
    status   String

    ask_order Order @relation("AskOrder", fields: [ask_order_id], references: [id])
    bid_order Order @relation("BidOrder", fields: [bid_order_id], references: [id])

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    ask_order_id String
    bid_order_id String

    sell_user    User @relation("SellFill", fields: [sell_user_id], references: [user_id])
    sell_user_id Int

    buy_user    User @relation("BuyFill", fields: [buy_user_id], references: [user_id])
    buy_user_id Int
}

model leverage {
    id Int @id @default(autoincrement())

    limit Int

    user    User @relation(fields: [user_id], references: [user_id])
    user_id Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([user_id])
}

model AssetPrice {
    id     Int    @id @default(autoincrement())
    symbol String

    index_price Decimal @db.Decimal(78, 0)
    mark_price  Decimal @db.Decimal(78, 0)

    timestamp DateTime @db.Timestamptz()

    created_at DateTime @default(now())

    asset   Asset? @relation(fields: [assetId], references: [id])
    assetId Int?

    @@unique([assetId, timestamp])
}

model Position {
    id        String @id @unique
    user      User   @relation(fields: [user_id], references: [user_id])
    user_id   Int
    market    Market @relation(fields: [market_id], references: [id])
    market_id Int

    side     String
    quantity Decimal @db.Decimal(78, 0)

    entryPrice Decimal @db.Decimal(78, 0)

    leverage       Int
    initial_margin Decimal @db.Decimal(78, 0)

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([user_id, market_id])
}
